<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="custody-definitions"
             targetNamespace="http://www.flowable.org/processdef">

    <!-- ========== 流程 3: 对账 (Reconciliation) ==========
         业务含义: 核对托管方与委托方数据,差异>0 需调账
         流程: 拉取两方数据 → 自动比对 → 差异>0? → 调账处理 → 完成
                                         ↘ 无差异 → 直接完成
         关键变量: diffCount(差异笔数), diffAmount(差异金额)
         ⚠️ 简历亮点: 对账必须在估值前 (与 valuation.bpmn20.xml 配合)
    -->
    <process id="reconciliation" name="对账流程" isExecutable="true">

        <startEvent id="startReconciliation" name="开始"/>
        <sequenceFlow id="flow1" sourceRef="startReconciliation" targetRef="serviceTaskFetchBoth"/>

        <serviceTask id="serviceTaskFetchBoth" name="拉取两方对账数据"
                     flowable:class="com.demo.custody.delegate.FetchBothDelegate"/>
        <sequenceFlow id="flow2" sourceRef="serviceTaskFetchBoth" targetRef="serviceTaskAutoMatch"/>

        <serviceTask id="serviceTaskAutoMatch" name="自动比对"
                     flowable:class="com.demo.custody.delegate.AutoMatchDelegate"/>
        <sequenceFlow id="flow3" sourceRef="serviceTaskAutoMatch" targetRef="exclusiveGatewayDiff"/>

        <!-- 关键判断: 差异>0 走调账, 否则直接通过 -->
        <exclusiveGateway id="exclusiveGatewayDiff" name="差异>0?"/>
        <sequenceFlow id="flow4_yes" name="是" sourceRef="exclusiveGatewayDiff" targetRef="userTaskAdjust">
            <conditionExpression xsi:type="tFormalExpression">${diffCount > 0}</conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flow4_no" name="否" sourceRef="exclusiveGatewayDiff" targetRef="serviceTaskWriteReconciliation">
            <conditionExpression xsi:type="tFormalExpression">${diffCount == 0 || diffCount == null}</conditionExpression>
        </sequenceFlow>

        <userTask id="userTaskAdjust" name="调账处理"
                  flowable:assignee="${operator}">
            <documentation>处理差异笔数: ${diffCount} 笔, 差异金额: ${diffAmount}</documentation>
        </userTask>
        <sequenceFlow id="flow5" sourceRef="userTaskAdjust" targetRef="serviceTaskWriteReconciliation"/>

        <serviceTask id="serviceTaskWriteReconciliation" name="写入对账结果"
                     flowable:class="com.demo.custody.delegate.WriteReconciliationDelegate"/>
        <sequenceFlow id="flow6" sourceRef="serviceTaskWriteReconciliation" targetRef="endReconciliation"/>

        <endEvent id="endReconciliation" name="对账完成"/>
    </process>

</definitions>
