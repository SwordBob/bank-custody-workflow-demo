<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="custody-definitions"
             targetNamespace="http://www.flowable.org/processdef">

    <!-- ========== 流程 2: 清算 (Clearing) ==========
         业务含义: 批量清算待处理交易
         流程: 拉取待清算 → 清算确认 → 写入清算结果 → 完成
         关键变量: batchNo(批次号), tradeCount(交易笔数), totalAmount(总金额)
    -->
    <process id="clearing" name="清算流程" isExecutable="true">

        <startEvent id="startClearing" name="开始"/>
        <sequenceFlow id="flow1" sourceRef="startClearing" targetRef="serviceTaskFetchPending"/>

        <serviceTask id="serviceTaskFetchPending" name="拉取待清算数据"
                     flowable:class="com.demo.custody.delegate.FetchPendingDelegate"/>
        <sequenceFlow id="flow2" sourceRef="serviceTaskFetchPending" targetRef="userTaskConfirmClearing"/>

        <userTask id="userTaskConfirmClearing" name="清算确认"
                  flowable:assignee="${operator}">
            <documentation>确认清算结果 (批次号/笔数/总金额)</documentation>
        </userTask>
        <sequenceFlow id="flow3" sourceRef="userTaskConfirmClearing" targetRef="serviceTaskWriteClearing"/>

        <serviceTask id="serviceTaskWriteClearing" name="写入清算结果"
                     flowable:class="com.demo.custody.delegate.WriteClearingDelegate"/>
        <sequenceFlow id="flow4" sourceRef="serviceTaskWriteClearing" targetRef="endClearing"/>

        <endEvent id="endClearing" name="清算完成"/>
    </process>

</definitions>
